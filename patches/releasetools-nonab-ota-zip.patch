From 4ac7e5afda0f832b548599f194108f186a5bd890 Mon Sep 17 00:00:00 2001
From: Kyle Richards <kylerichards952806@gmail.com>
Date: Mon, 16 Nov 2026 19:02:06 +0000
Subject: [PATCH] releasetools: stop the A-only OTA zip from following symlinks

non_ab_ota.py archived the target files without -y, so zip followed ROOT/d into /sys/kernel/debug and hung forever. ZIPOPT does not reach this invocation.
---
 tools/releasetools/non_ab_ota.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/releasetools/non_ab_ota.py b/tools/releasetools/non_ab_ota.py
index 47c269a1ce..2e7920bbba 100644
--- a/tools/releasetools/non_ab_ota.py
+++ b/tools/releasetools/non_ab_ota.py
@@ -623,7 +623,7 @@ def GenerateNonAbOtaPackage(target_file, output_file, source_file=None):
       tmpfile = common.MakeTempFile(suffix=".zip")
       os.unlink(tmpfile)
       common.RunAndCheckOutput(
-          ["zip", tmpfile, "-r", ".", "-0"], cwd=target_file)
+          ["zip", tmpfile, "-y", "-r", ".", "-0"], cwd=target_file)
       assert zipfile.is_zipfile(tmpfile)
       target_file = tmpfile
 
-- 
