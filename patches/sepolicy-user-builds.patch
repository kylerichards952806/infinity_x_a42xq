From d8b331f4a6cc7550afdcd34d34d9a4a3e066ef6d Mon Sep 17 00:00:00 2001
From: Kyle Richards <kylerichards952806@gmail.com>
Date: Mon, 16 Nov 2026 14:22:26 +0000
Subject: [PATCH] a42xq: let SystemUI actually read ro.usb.uvc.enabled

The previous change only silenced the audit trail: the appdomain neverallow still
denied platform_app, so SystemUI got no value. Carve platform_app out of that
neverallow (platform-key signed, same trust class as the already-exempt
system_app) and grant the read with get_prop instead of dontaudit.
---
 private/platform_app.te | 5 ++++-
 private/property.te     | 1 +
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/private/platform_app.te b/private/platform_app.te
index a7c46a80b..4c1311ec8 100644
--- a/private/platform_app.te
+++ b/private/platform_app.te
@@ -15,4 +15,7 @@ platform_app_domain(platform_app)
 
 # SystemUI polls ro.usb.uvc.enabled; the appdomain neverallow keeps the read
 # denied, so silence the recurring audit denial.
-dontaudit platform_app usb_uvc_enabled_prop:file read;
+# SystemUI reads ro.usb.uvc.enabled to drive the webcam UI. platform_app is
+# platform-key signed, the same trust level the neverallow already grants to
+# system_app, so carve it out there and allow the read here.
+get_prop(platform_app, usb_uvc_enabled_prop)
diff --git a/private/property.te b/private/property.te
index 762f92d03..13c2ec1ac 100644
--- a/private/property.te
+++ b/private/property.te
@@ -890,6 +890,7 @@ neverallow {
   appdomain
   -system_app
   -device_as_webcam
+  -platform_app
 } usb_uvc_enabled_prop:file no_rw_file_perms;
 
 neverallow {
-- 
2.43.0

